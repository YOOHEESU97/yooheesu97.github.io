---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { comparePostsByDateDesc } from '../../utils/postDate';
import { withBase } from '../../utils/withBase';

const posts = (await getCollection('blog')).sort(comparePostsByDateDesc);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`Notes | ${SITE_TITLE}`}
			description="개발 경험과 투자 공부를 기록한 노트 모음입니다."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Notes</h1>
				<span class="article-count">{posts.length} Articles</span>
			</div>
			<p class="intro">개발 경험과 투자 공부를 정리한 노트 모음입니다.</p>
			<ul class="post-grid">
				{
					posts.map((post) => (
						<li>
							<PostCard
								href={withBase(`blog/${post.id}/`)}
								title={post.data.title}
								description={post.data.description}
								pubDate={post.data.pubDate}
								publishedAt={post.data.publishedAt}
								updatedDate={post.data.updatedDate}
								category={post.data.category}
								tags={post.data.tags}
							/>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin: -1rem 0 2rem;
		color: var(--text-muted);
		font-size: 1.05rem;
	}
</style>
